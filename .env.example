# List of environment variables this app needs. Production-only project:
# the real values live ONLY in Vercel → Settings → Environment Variables, scoped to "Production".
# Never commit real values. There is no local .env.

NODE_ENV=production
APP_URL=https://your-app.vercel.app    # no trailing slash
TZ_APP=Asia/Jakarta

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=               # 32+ random chars [A-Za-z0-9_-]
OWNER_TELEGRAM_ID=                     # your numeric Telegram ID; first /start from it becomes OWNER

# Neon Postgres (Singapore, main branch)
DATABASE_URL=                          # POOLED connection string (host contains -pooler), sslmode=require
DIRECT_URL=                            # DIRECT connection string, used by prisma migrate deploy

# Groq (free tier, NLP fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=5000
LLM_DAILY_LIMIT_PER_USER=50

# Vercel Cron
CRON_SECRET=                           # 32+ random chars

# Sessions
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=5
